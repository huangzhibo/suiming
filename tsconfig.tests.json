{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"noEmit": true,
		"paths": {
			"@suiming/runtime": [
				"./packages/runtime/src/index.ts"
			],
			"@suiming/sdk": [
				"./packages/sdk/src/index.ts"
			],
			"@suiming/story": [
				"./packages/story/src/index.ts"
			]
		}
	},
	"include": [
		"packages/*/test/**/*.ts",
		"apps/*/test/**/*.ts"
	]
}
