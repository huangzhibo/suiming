# Temporary environment overrides for development and CI. The local product will use
# ~/.suiming/config.toml for model routing and a separate credential store for secrets.
# The main profile is required; task profiles below fall back to it when omitted.
# *_MODEL_OPTIONS are passed to pi-ai's API-level stream call and validated at bind
# against that API's option names (openai-completions uses reasoningEffort, not the
# streamSimple key reasoning; anthropic-messages uses thinkingEnabled / effort).
# Unknown keys fail with invalid_model_options instead of being silently ignored.
SUIMING_MAIN_MODEL_PROVIDER=
SUIMING_MAIN_MODEL_ID=
# SUIMING_MAIN_MODEL_OPTIONS={"maxTokens":65536,"reasoningEffort":"high"}

# SUIMING_REVIEWER_MODEL_PROVIDER=
# SUIMING_REVIEWER_MODEL_ID=
# SUIMING_REVIEWER_MODEL_OPTIONS={"maxTokens":8192}

# Source Reader falls back to the main profile when omitted. Configure it separately for
# long-context Source reading when that task benefits from another model.
# Writer 建议单独配置：正文一次要输出上万码点，reasoning 会把 maxTokens 吃光、一个字也写不出来（报 model_output_truncated）。
# DeepSeek 经 pi-ai 只能开关 thinking（写任意 reasoningEffort 即开启，不写即关闭），效果档位不会送到 API；
# 2026-09-05 实测 deepseek-v4-flash 写 1.1 万字正文时 65536 全被 reasoning 用掉，要么把 maxTokens 提到 200000 以上，要么不开 thinking。
# SUIMING_WRITER_MODEL_PROVIDER=
# SUIMING_WRITER_MODEL_ID=
# SUIMING_WRITER_MODEL_OPTIONS={"maxTokens":200000,"reasoningEffort":"low"}

# 盲读评委（run rank）。应与 Writer 不同的模型，否则结果带自评倾向；未配置时回落到 main。
# SUIMING_JUDGE_MODEL_PROVIDER=
# SUIMING_JUDGE_MODEL_ID=
# SUIMING_JUDGE_MODEL_OPTIONS={"maxTokens":16384}

# SUIMING_SOURCE_READER_MODEL_PROVIDER=
# SUIMING_SOURCE_READER_MODEL_ID=
# SUIMING_SOURCE_READER_MODEL_OPTIONS={"maxTokens":8192}

# Source Extractor falls back to the main profile when omitted. Configure it separately when
# synthesis benefits from a model with stronger structured long-output ability.
# SUIMING_SOURCE_EXTRACTOR_MODEL_PROVIDER=
# SUIMING_SOURCE_EXTRACTOR_MODEL_ID=
# SUIMING_SOURCE_EXTRACTOR_MODEL_OPTIONS={"maxTokens":32768}

# Configure only the provider credentials actually used by the selected profiles.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# ZAI_API_KEY=

# Qwen Token Plan uses a dedicated plan key and provider id. Do not put an sk-sp- key
# in DASHSCOPE_API_KEY or combine it with the pay-as-you-go DashScope endpoint.
# China: provider=qwen-token-plan-cn
# QWEN_TOKEN_PLAN_CN_API_KEY=
# International Individual: provider=qwen-token-plan-individual
# QWEN_TOKEN_PLAN_API_KEY=

# Optional observability. With both Langfuse keys set, every turn exports an OpenTelemetry
# trace (session -> turn -> Task -> model call spans) to Langfuse over OTLP HTTP.
# Base URL defaults to https://cloud.langfuse.com.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=http://localhost:3000

# Cloud API / Worker process configuration. S3 credentials may be omitted when
# the deployment provides the standard AWS credential chain.
# SUIMING_POSTGRES_URL=postgresql://suiming:password@127.0.0.1:5432/suiming
# SUIMING_POSTGRES_MAX_CONNECTIONS=10
# SUIMING_POSTGRES_APPLICATION_NAME=
# SUIMING_S3_REGION=us-east-1
# SUIMING_S3_BUCKET=suiming
# SUIMING_S3_ENDPOINT=http://127.0.0.1:9000
# SUIMING_S3_FORCE_PATH_STYLE=true
# SUIMING_S3_KEY_PREFIX=
# SUIMING_S3_ACCESS_KEY_ID=
# SUIMING_S3_SECRET_ACCESS_KEY=
# SUIMING_S3_SESSION_TOKEN=
# SUIMING_CLOUD_INLINE_TEXT_THRESHOLD_BYTES=262144

# Current executable API bootstrap is deliberately single-actor. Replace its
# injected authenticator for a multi-user deployment; never reuse this token as
# an S3, model-provider, or Langfuse credential.
# SUIMING_CLOUD_ACTOR_ID=
# SUIMING_CLOUD_ACCESS_TOKEN=
# SUIMING_API_HOST=127.0.0.1
# SUIMING_API_PORT=3001

# Optional real Cloud adapter integration tests. Use disposable PostgreSQL and
# S3-compatible services; tests create schema rows and bucket objects.
# SUIMING_TEST_POSTGRES_URL=postgresql://suiming:password@127.0.0.1:5432/suiming
# SUIMING_TEST_S3_ENDPOINT=http://127.0.0.1:9000
# SUIMING_TEST_S3_REGION=us-east-1
# SUIMING_TEST_S3_BUCKET=suiming-integration-test
# SUIMING_TEST_S3_ACCESS_KEY=
# SUIMING_TEST_S3_SECRET_KEY=
# SUIMING_TEST_DURABLE_DEPLOYMENT=1
# SUIMING_TEST_DURABLE_PROCESS=1

# Where the product reads routing and credentials. Defaults are ~/.suiming/config.toml and
# ~/.suiming/auth.json; tests and side-by-side environments point both elsewhere.
# SUIMING_CONFIG_PATH=
# SUIMING_AUTH_PATH=
